// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CONFIGURAÇÃO GLOBAL
// ============================================================================

/// Parâmetros globais de precificação da agência
model ConfigAgencia {
  id                    String   @id @default(cuid())

  // Parâmetros de margem e overhead
  margemAlvoPct         Decimal  @db.Decimal(5, 2) @default(30) // 30%
  horaEmpresaSugerida   Decimal  @db.Decimal(10, 2) @default(150) // R$ 150/h

  // Ajustes sazonais e mercado
  ajusteInflacao        Decimal  @db.Decimal(5, 2) @default(0) // 0% = sem ajuste
  ajusteTemporada       Decimal  @db.Decimal(5, 2) @default(0) // 0% = sem ajuste

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
}

// ============================================================================
// RECURSOS HUMANOS
// ============================================================================

/// Profissionais (sócios, funcionários, freelancers)
model Profissional {
  id                    String   @id @default(cuid())
  nome                  String
  funcao                String   // "Designer", "Copywriter", "Editor", etc
  tipo                  String   // "interno" | "freelance"
  horaCusto             Decimal  @db.Decimal(10, 2) // Custo real por hora
  capacidadeMes         Int      @default(160) // Horas disponíveis/mês
  ativo                 Boolean  @default(true)

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  // Relações
  entregaveis           EntregavelCatalogo[]
  orcamentoItens        OrcamentoItem[]
}

/// Custos fixos da agência (salários, aluguel, software, etc)
model OverheadItem {
  id                    String   @id @default(cuid())
  descricao             String   // "Salário Designer", "Adobe CC", etc
  valor                 Decimal  @db.Decimal(10, 2)
  frequencia            String   // "mensal" | "trimestral" | "anual"
  ativo                 Boolean  @default(true)

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
}

// ============================================================================
// CATÁLOGO DE SERVIÇOS
// ============================================================================

/// Tipos de entregável (Post, Reels, Stories, etc) com tempo padrão
model EntregavelCatalogo {
  id                    String   @id @default(cuid())
  nome                  String   // "Post Instagram", "Reels 30s", etc
  descricao             String?
  tipo                  String   // "post" | "reels" | "stories" | "email" | "design" | etc

  // Tempo padrão de criação
  horasPadraoMin        Int      // Horas mínimas estimadas
  horasPadraoMax        Int      // Horas máximas estimadas

  // Profissional responsável
  profissionalId        String?
  profissional          Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)

  // Preço fixo alternativo (se não usar modelo de horas)
  precoFisoOpcional     Decimal? @db.Decimal(10, 2)

  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  // Relações
  orcamentoItens        OrcamentoItem[]
}

// ============================================================================
// CLIENTES E ORÇAMENTOS
// ============================================================================

/// Cadastro de clientes
model Cliente {
  id                    String   @id @default(cuid())
  nome                  String
  email                 String   @unique
  telefone              String?
  cnpj                  String?  @unique
  endereco              String?
  cidade                String?
  estado                String?

  // Contexto de negócio (para segmentação)
  tagContextoAtual      String?  // "ecommerce", "saas", "agencia", etc

  // Preferências
  contatoPrincipal      String?
  desconto              Decimal  @db.Decimal(5, 2) @default(0) // % de desconto padrão

  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  // Relações
  orcamentos            Orcamento[]
}

/// Templates de orçamento (estruturas reutilizáveis)
model Template {
  id                    String   @id @default(cuid())
  nome                  String
  descricao             String?

  // Campos do template (armazenado como JSON)
  estrutura             String   // JSON serializado com campos customizáveis

  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  // Relações
  orcamentos            Orcamento[]
}

/// Orçamentos gerados
model Orcamento {
  id                    String   @id @default(cuid())
  numero                String   @unique // REF-001, REF-002, etc

  // Relacionamentos
  clienteId             String
  cliente               Cliente  @relation(fields: [clienteId], references: [id])

  templateId            String?
  template              Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Status e controle
  status                String   @default("Rascunho") // "Rascunho" | "Pendente" | "Aprovado" | "Rejeitado"

  // Datas
  dataEmissao           DateTime @default(now())
  dataValidade          DateTime? // 30 dias por padrão

  // Termos e condições
  termos                String?
  garantia              String?

  // Descontos e ajustes
  descontoPercentual    Decimal  @db.Decimal(5, 2) @default(0)

  // Valores calculados (denormalizados para performance)
  totalServiços         Decimal  @db.Decimal(12, 2) @default(0) // Sum de todos itens
  totalOverhead         Decimal  @db.Decimal(12, 2) @default(0) // Overhead alocado
  totalFinal            Decimal  @db.Decimal(12, 2) @default(0) // Total com margem

  // Versionamento
  versaoAtual           Int      @default(1)

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  // Relações
  itens                 OrcamentoItem[]
  versoes               OrcamentoVersion[]
}

/// Itens dentro de um orçamento
model OrcamentoItem {
  id                    String   @id @default(cuid())

  // Relacionamentos
  orcamentoId           String
  orcamento             Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  entregavelId          String
  entregavel            EntregavelCatalogo @relation(fields: [entregavelId], references: [id])

  profissionalId        String?
  profissional          Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)

  // Mudança fundamental: de preçoUnitario para horasUnitarias
  horasUnitarias        Decimal  @db.Decimal(10, 2) // Horas necessárias
  horaVendidaAplicada   Decimal  @db.Decimal(10, 2) // Valor/hora que será cobrado

  // Quantidade
  quantidade            Int      @default(1)

  // Valores calculados
  subtotal              Decimal  @db.Decimal(12, 2) // horasUnitarias * horaVendidaAplicada * quantidade

  // Descrição customizada
  descricao             String?

  ordem                 Int      @default(0) // Para ordenação visual

  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@index([orcamentoId])
  @@index([entregavelId])
}

/// Histórico de versões de orçamentos
model OrcamentoVersion {
  id                    String   @id @default(cuid())

  orcamentoId           String
  orcamento             Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  numero                Int      // 1, 2, 3, ...

  // Snapshot dos dados (JSON)
  snapshot              String   // Orçamento serializado

  motivoMudanca         String?  // "Ajuste de escopo", "Cliente pediu redução", etc

  criadoEm              DateTime @default(now())

  @@unique([orcamentoId, numero])
  @@index([orcamentoId])
}

// ============================================================================
// LEGACY (NÃO USAR NO NOVO MODELO)
// ============================================================================

/// LEGACY — Sistema antigo de serviços por preço fixo.
/// Não usar no novo modelo. Mantido apenas para referência/rollback.
/// Remover após validação completa da v1.
model Service_legacy {
  id                    String   @id @default(cuid())
  nome                  String
  descricao             String?
  priceMin              Decimal  @db.Decimal(10, 2)
  priceMax              Decimal  @db.Decimal(10, 2)
  estimatedHours        Int?
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@map("Service")
  @@deprecated("Use EntregavelCatalogo instead")
}
